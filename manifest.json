{
  "manifest_version": 3,
  "name": "Bookmark Extender",
  "version": "0.1.0",
  "description": "Extends the bookmark experience with automatic multi-row bookmark wrapping.",
  "permissions": [
    "bookmarks",
    "storage"
  ],
  "action": {
    "default_title": "Bookmark Extender"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "options_page": "src/test.html"
}